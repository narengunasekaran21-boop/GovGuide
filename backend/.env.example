# Server
PORT=5000
NODE_ENV=development

# Client origin (for CORS)
CLIENT_ORIGIN=http://localhost:5173

# JWT
JWT_SECRET=change_this_to_a_long_random_secret_in_production
JWT_EXPIRES_IN=1d

# Database (SQLite file path)
DATABASE_PATH=./database/govguide.db

# Seeded demo admin account (development only — change immediately after first login)
SEED_ADMIN_EMAIL=admin@govguide.demo
SEED_ADMIN_PASSWORD=Admin@12345
SEED_ADMIN_NAME=GovGuide Admin
