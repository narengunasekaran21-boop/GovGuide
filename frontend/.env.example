# Local dev: leave this unset. Vite's dev server proxies /api to
# localhost:5000 automatically (see vite.config.js) — you don't need this.
#
# Production build (e.g. deploying to Render/Vercel/Netlify as a static
# site, separate from the backend): this IS required. Set it to your
# deployed backend's full URL, including /api, e.g.:
#   VITE_API_BASE_URL=https://govguide-backend.onrender.com/api
# Vite only bakes VITE_-prefixed env vars in at BUILD time, so this must be
# set in your hosting provider's build environment settings, not just here.
VITE_API_BASE_URL=http://localhost:5000/api
